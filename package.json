{
  "name": "outlander-tour-companion",
  "productName": "Outlander Tour Companion",
  "version": "1.2.11",
  "description": "Offline desktop companion for the Outlander in Concert tour.",
  "author": "Arodreeds",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --x64",
    "dist:universal": "electron-builder --mac --universal",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "test": "node e2e_test.js && node e2e_migration_test.js && node e2e_corrupted_save_test.js && node e2e_save_folder_test.js && node e2e_storage_failure_test.js && node e2e_update_test.js && node e2e_update_failure_test.js && node e2e_feature_smoke_test.js",
    "test:packaged": "node e2e_packaged_test.js"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "playwright": "^1.62.1"
  },
  "build": {
    "appId": "com.outlandertour.companion",
    "productName": "Outlander Tour Companion",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "fonts/**/*",
      "vendor/**/*",
      "images/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
